{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubMind",
  "version": "0.1.0",
  "identifier": "com.submind.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/desktop-web.mjs dev",
    "beforeBuildCommand": "node ../../scripts/desktop-web.mjs build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "SubMind",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
