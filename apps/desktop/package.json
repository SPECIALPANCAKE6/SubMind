  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@submind/core": "0.1.0",
    "@submind/policy": "0.1.0",
    "@submind/protocol-codex": "0.1.0",
    "@submind/shared-schemas": "0.1.0",
    "@submind/store": "0.1.0",
    "@submind/ui-components": "0.1.0",
    "@submind/ui-state": "0.1.0",
    "@submind/workers": "0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
