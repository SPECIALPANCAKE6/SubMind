{
  "name": "@submind/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "browser:build": "vite build --config vite.config.ts",
    "browser:dev": "vite --config vite.config.ts",
    "tauri:dev": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri dev --config src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/sora": "^5.2.6",
    "@submind/core": "workspace:*",
    "@submind/policy": "workspace:*",
    "@submind/protocol-codex": "workspace:*",
    "@submind/shared-schemas": "workspace:*",
    "@submind/store": "workspace:*",
    "@submind/ui-components": "workspace:*",
    "@submind/ui-state": "workspace:*",
    "@submind/workers": "workspace:*",
    "@tanstack/react-query": "^5.90.5",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
