{
  "name": "submind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b",
    "desktop:browser:build": "tsc -b && cd apps\\desktop && vite build --config vite.config.ts",
    "desktop:browser:dev": "tsc -b && cd apps\\desktop && vite --config vite.config.ts",
    "desktop:tauri:dev": "cd apps\\desktop && set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "tsc -b && cd apps\\desktop && vite build --config vite.config.ts",
    "desktop:dev": "tsc -b && cd apps\\desktop && vite --config vite.config.ts",
    "shell:output": "tsc -b && node scripts/preview-shell.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run packages/shared-schemas/test/shared-schemas.test.ts packages/protocol-codex/test/protocol-codex.test.ts packages/store/test/store.test.ts packages/workers/test/workers.test.ts packages/ui-state/test/ui-state.test.ts packages/ui-components/test/ui-components.test.ts --pool=threads --poolOptions.threads.singleThread"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "vitest": "^3.1.1"
  }
}
